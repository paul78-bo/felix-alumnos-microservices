server:
  port: 8080

spring:
  application:
    name: Felix-API-GATEWAY
  
  autoconfigure:
    exclude: 
      - org.springframework.boot.autoconfigure.data.redis.RedisAutoConfiguration
      - org.springframework.boot.autoconfigure.data.redis.RedisReactiveAutoConfiguration
  
  cloud:
    gateway:
      routes:
        # ==============================================
        # 1. RUTAS ESPECÍFICAS PRIMERO (MÁS ESPECÍFICAS ARRIBA)
        # ==============================================
        # RUTA PARA RESET PASSWORD (MUY ESPECÍFICA)
        - id: reset-password-route
          uri: http://localhost:8081
          predicates:
            - Path=/reset-password/**
        
        # RUTA PARA LOGIN PAGE
        - id: login-page
          uri: http://localhost:8082
          predicates:
            - Path=/login.html
        
        # RUTA PARA API (MENOS ESPECÍFICA)
        - id: backend-route
          uri: http://localhost:8081
          predicates:
            - Path=/api/**
        
        # ==============================================
        # 2. RUTA GENÉRICA AL FINAL (CATCH-ALL)
        # ==============================================
        - id: frontend-root
          uri: http://localhost:8082
          predicates:
            - Path=/**
      
      globalcors:
        corsConfigurations:
          '[/**]':
            allowedOrigins:
              - "http://localhost:8082"
              - "http://localhost:8080"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
              - PATCH
              - HEAD
            allowedHeaders:
              - "*"
            allowCredentials: true
            maxAge: 3600
      
      httpclient:
        connect-timeout: 30000
        response-timeout: 60s

logging:
  level:
    org.springframework.cloud.gateway: DEBUG
    org.springframework.web: DEBUG
    reactor.netty: DEBUG
    com.peral.Felix_API_GATEWAY: DEBUG

# ==============================================
# CONFIGURACIÓN SENSIBLE
# ==============================================
# Configura tu propia clave secreta JWT
# Debe ser larga (mínimo 32 caracteres) y única
jwt:
  secret: ${JWT_SECRET:tu_clave_secreta_jwt_muy_larga_y_segura_aqui_minimo_32_caracteres}